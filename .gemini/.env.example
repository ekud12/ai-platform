# Wiggum Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Required: Your Gemini API Key
GEMINI_API_KEY=your-api-key-here

# Optional: Model configuration
WIGGUM_MODEL=gemini-2.0-flash
WIGGUM_PLANNING_MODEL=gemini-2.0-flash

# Optional: Rate limiting
WIGGUM_RATE_LIMIT=100
WIGGUM_RATE_LIMIT_MINUTE=10

# Optional: Execution limits
WIGGUM_MAX_STEPS=50
WIGGUM_MAX_TIME=3600

# Optional: Behavior flags
WIGGUM_DRY_RUN=false
WIGGUM_VERBOSE=false
