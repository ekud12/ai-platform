{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "Secret detection patterns - prevents accidental credential exposure",

  "secret_patterns": [
    {
      "id": "jwt-token",
      "pattern": "eyJ[A-Za-z0-9-_=]+\\.[A-Za-z0-9-_=]+\\.?[A-Za-z0-9-_.+/=]*",
      "flags": "i",
      "description": "JSON Web Token (JWT)",
      "severity": "critical"
    },
    {
      "id": "openai-api-key",
      "pattern": "sk-[a-zA-Z0-9]{20,}",
      "flags": "",
      "description": "OpenAI API Key",
      "severity": "critical"
    },
    {
      "id": "anthropic-api-key",
      "pattern": "sk-ant-[a-zA-Z0-9-]{20,}",
      "flags": "",
      "description": "Anthropic API Key",
      "severity": "critical"
    },
    {
      "id": "google-api-key",
      "pattern": "AIza[0-9A-Za-z-_]{35}",
      "flags": "",
      "description": "Google API Key",
      "severity": "critical"
    },
    {
      "id": "github-pat",
      "pattern": "ghp_[a-zA-Z0-9]{36}",
      "flags": "",
      "description": "GitHub Personal Access Token",
      "severity": "critical"
    },
    {
      "id": "github-oauth",
      "pattern": "gho_[a-zA-Z0-9]{36}",
      "flags": "",
      "description": "GitHub OAuth Token",
      "severity": "critical"
    },
    {
      "id": "github-app",
      "pattern": "ghu_[a-zA-Z0-9]{36}",
      "flags": "",
      "description": "GitHub App User Token",
      "severity": "critical"
    },
    {
      "id": "aws-access-key",
      "pattern": "AKIA[0-9A-Z]{16}",
      "flags": "",
      "description": "AWS Access Key ID",
      "severity": "critical"
    },
    {
      "id": "aws-secret-key",
      "pattern": "[0-9a-zA-Z/+]{40}",
      "flags": "",
      "description": "AWS Secret Access Key (requires context)",
      "severity": "high",
      "requires_context": ["aws", "secret", "key"]
    },
    {
      "id": "azure-connection-string",
      "pattern": "DefaultEndpointsProtocol=https;AccountName=[^;]+;AccountKey=[^;]+",
      "flags": "i",
      "description": "Azure Storage Connection String",
      "severity": "critical"
    },
    {
      "id": "azure-sas-token",
      "pattern": "sv=[0-9-]+&s[a-z]=.*&sig=[A-Za-z0-9%]+",
      "flags": "",
      "description": "Azure SAS Token",
      "severity": "critical"
    },
    {
      "id": "slack-token",
      "pattern": "xox[baprs]-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*",
      "flags": "",
      "description": "Slack Token",
      "severity": "critical"
    },
    {
      "id": "stripe-api-key",
      "pattern": "sk_live_[0-9a-zA-Z]{24,}",
      "flags": "",
      "description": "Stripe Live API Key",
      "severity": "critical"
    },
    {
      "id": "stripe-test-key",
      "pattern": "sk_test_[0-9a-zA-Z]{24,}",
      "flags": "",
      "description": "Stripe Test API Key",
      "severity": "medium"
    },
    {
      "id": "twilio-api-key",
      "pattern": "SK[0-9a-fA-F]{32}",
      "flags": "",
      "description": "Twilio API Key",
      "severity": "critical"
    },
    {
      "id": "sendgrid-api-key",
      "pattern": "SG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}",
      "flags": "",
      "description": "SendGrid API Key",
      "severity": "critical"
    },
    {
      "id": "private-key-header",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "flags": "",
      "description": "Private Key File",
      "severity": "critical"
    },
    {
      "id": "generic-password",
      "pattern": "(password|passwd|pwd|secret)\\s*[=:]\\s*['\"][^'\"]{8,}['\"]",
      "flags": "i",
      "description": "Hardcoded Password",
      "severity": "high"
    },
    {
      "id": "generic-api-key",
      "pattern": "(api[_-]?key|apikey)\\s*[=:]\\s*['\"][a-zA-Z0-9]{16,}['\"]",
      "flags": "i",
      "description": "Generic API Key",
      "severity": "high"
    },
    {
      "id": "connection-string",
      "pattern": "(Server|Data Source)=[^;]+;.*(Password|Pwd)=[^;]+",
      "flags": "i",
      "description": "Database Connection String with Password",
      "severity": "critical"
    }
  ],

  "exclusions": [
    {
      "pattern": "\\.example$|\\.sample$|\\.template$",
      "description": "Exclude example/sample/template files"
    },
    {
      "pattern": "test[_-]?data|mock[_-]?data|fake[_-]?data",
      "description": "Exclude test data contexts"
    }
  ],

  "settings": {
    "scan_file_writes": true,
    "scan_command_output": false,
    "block_on_detection": true,
    "log_detections": true,
    "log_file": ".gemini/logs/secret-detections.log"
  }
}
